# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# The local database (the Rust sync, the content tables) and the snapshot built
# from it for the deploy: salary and listening data, never committed.
.data/
apps/*/web/public/api/
apps/*/web/public/sw.js
apps/*/web/public/banners/
apps/*/web/public/covers/
apps/*/web/public/artists/
apps/*/web/public/icons/
apps/*/web/public/logos/
apps/*/web/public/posters/
apps/*/web/public/backdrops/

# Rust
target/
.wrangler/

# CSV-eksporter fra nettbanken i apps/forbruk: inneholder ekte
# transaksjonsdata, skal ikke i git.
apps/forbruk/data/transaksjoner/*.csv

# Compiled and cached output
.cache/
.temp/
.tmp/
*.log
npm-debug.log*
yarn-error.log*

# Environment and secrets.
#
# The negative patterns matter as much as the positive ones. An ignore rule
# like `.env` does not cover `.env.production`, and a rule like `*.key` does not
# cover a file named `secrets.yml`. Secrets land in repositories under names
# nobody predicted, so the blocklist below is deliberately broad.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
secrets.yml
secrets.yaml
credentials.json
.npmrc
!/.npmrc
!templates/.npmrc
!apps/*/.npmrc
!apps/*/web/.npmrc
!packages/*/.npmrc*
.netrc
.pgpass
.aws/
.ssh/

# AI tooling state
.lane/
.claude/settings.local.json

# Lockfiles for package managers this repository does not use. Keeping the one
# you use and ignoring the rest prevents a stray install from committing a
# second, conflicting lockfile.
pnpm-lock.yaml
yarn.lock
bun.lockb

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
# Local-only Worker variables for `wrangler dev`/`vite preview`; may hold secrets.
.dev.vars*

# Playwright MCP writes its page snapshots here.
.playwright-mcp/

# Local research notes. They name private people, so they never get committed.
/.local/

# Browser tests (npm run e2e): screenshots, traces, videos and the HTML report.
e2e/screenshots/
e2e/results/
e2e/report/
.astro/

# Kept private, in the monorepo: never committed here.
secrets/
data-dump/
