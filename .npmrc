# On a machine where npm's user or global config overrides the registry (a
# corporate Nexus/Artifactory proxy, for example), every project silently
# installs through that proxy unless it says otherwise here. A project-level
# `.npmrc` takes precedence over `~/.npmrc`, so this is the one place a
# personal or open-source project can guarantee it talks to the public
# registry regardless of which machine it is cloned onto.
#
# Check what a machine actually defaults to before assuming this is needed:
#   npm config get registry
registry=https://registry.npmjs.org/

# A package that asks for a newer Node than the one running fails the install, so `deps-update` stops at `npm ci`/`npm update`
# with the reason instead of a publish timer failing later in a build. The Node is `.node-version` (`scripts/node-runtime.ts`).
engine-strict=true
