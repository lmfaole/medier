---
// `/historikk?year=YYYY`: the log line by line, a year at a time. Plain HTML.
import { notFoundPage, readPage } from '@designsystem/config/astro-api'
import { hereOf } from '@designsystem/shelf/here'
import ShelfPage from '@designsystem/shelf/layouts/shelf-page'
import { legacyYearOf, YearSearch } from '@designsystem/ui/lib/period-search'
import { yearHistoryRequest } from '@designsystem/ui/lib/page-requests'
import * as v from 'valibot'

import { RESPONSES } from '@/server/responses'
import { History } from '@/views/boardgames'
import '../index.css'

const here = hereOf(Astro.url)
// An old link with `?month=YYYY-MM` goes on to the year that month is in.
const legacyYear = legacyYearOf(Astro.url.searchParams)
if (legacyYear !== null) return Astro.redirect(`${Astro.url.pathname}?year=${legacyYear}`, 301)
const search = v.parse(YearSearch, Object.fromEntries(Astro.url.searchParams))
const history = await readPage(Astro.url, yearHistoryRequest(search), RESPONSES.history).catch(() => null)
// A year the snapshot has no file for is not a page.
if (history === null) {
  Astro.cache.set(false)
  return notFoundPage()
}
---

<ShelfPage app="boardgames" title="Historikk" here={here}>
  <History data={history} />
</ShelfPage>
