---
// `/bibliotek?q=&status=&kind=&format=`: what the owner has and wants, found and narrowed by the address. The server draws
// the list already narrowed; the filters are the one part that needs a script, so the view hydrates when the browser is idle.
import { readPage } from '@designsystem/config/astro-api'
import { hereOf } from '@designsystem/shelf/here'
import ShelfPage from '@designsystem/shelf/layouts/shelf-page'
import { LibrarySearch } from '@designsystem/ui/lib/library-search'
import { libraryRequest } from '@designsystem/ui/lib/page-requests'
import * as v from 'valibot'

import { RESPONSES } from '@/server/responses'
import { Library } from '@/views/boardgames'
import '../index.css'

const here = hereOf(Astro.url)
const search = v.parse(LibrarySearch, Object.fromEntries(Astro.url.searchParams))
const library = await readPage(Astro.url, libraryRequest(), RESPONSES.library)
---

<ShelfPage app="boardgames" title="Bibliotek" here={here}>
  <Library data={library} search={search} client:idle />
</ShelfPage>
