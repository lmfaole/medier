---
// `/bok/[slug]`: one work's own page. The log chart hydrates when seen.
import { notFoundPage, readPage } from '@designsystem/config/astro-api'
import { hereOf } from '@designsystem/shelf/here'
import ShelfPage from '@designsystem/shelf/layouts/shelf-page'
import { entityRequest } from '@designsystem/ui/lib/page-requests'
import { SlugParams } from '@designsystem/ui/lib/slug-params'
import * as v from 'valibot'

import { RESPONSES } from '@/server/responses'
import { Entity } from '@/views/shelf'
import '../../index.css'

const here = hereOf(Astro.url)
const params = v.safeParse(SlugParams, Astro.params)
// A slug that is not one, or that no work has, is not a page.
const work = params.success ? await readPage(Astro.url, entityRequest(params.output.slug), RESPONSES.entity).catch(() => null) : null
if (work === null) {
  Astro.cache.set(false)
  return notFoundPage()
}
---

<ShelfPage app="books" title={work.title} here={here} thing>
  <Entity data={work} client:visible />
</ShelfPage>
