---
// `/`: the CV, with the projects under the roles they were done in. It reads `cv.json` from the snapshot, so it is
// rendered per request (and cached at the edge), never prerendered; it sends no script.
import { readApi } from '@designsystem/config/astro-api'
import Document from '@designsystem/ui/layouts/document'

import { RESPONSES } from '@/server/responses'
import { Work } from '@/views/Work'
import '../index.css'

const TITLE = 'Ole Jørgen Bakken, frontendutvikler'
const DESCRIPTION = 'Hva jeg jobber med: CV-en min og prosjektene jeg har jobbet med, med siste commit.'

const cv = await readApi(Astro.url, 'cv', RESPONSES.cv)
---

<Document title={TITLE} index og={{ title: TITLE, description: DESCRIPTION, url: 'https://lmfaole.party/cv' }}>
  <Work cv={cv} />
</Document>
