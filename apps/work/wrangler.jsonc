{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work",
  "main": "web/src/server.ts",
  "compatibility_date": "2026-10-04",
  // Astro's Cloudflare adapter needs AsyncLocalStorage, which comes with nodejs_compat.
  "compatibility_flags": ["nodejs_compat"],

  // Same account as every app, so `deploy` does not stop with "More than one
  // account available" in a non-interactive context.
  "account_id": "5d49b98b68b70cbd1c81be0f18501262",

  // A path of lmfaole.party (zone routes: a custom domain cannot carry a path). `forside` owns `lmfaole.party/*`; these two are more
  // specific and so reach this Worker. The old host stays a custom domain only so that it can answer with a redirect to the new address.
  "routes": [
    { "pattern": "lmfaole.party/cv", "zone_name": "lmfaole.party" },
    { "pattern": "lmfaole.party/cv/*", "zone_name": "lmfaole.party" },
    { "pattern": "jobb.lmfaole.party", "custom_domain": true }
  ],

  // One address, no *.workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // The Worker runs for every request so the security headers and the
    // /api/ routes apply.
    "run_worker_first": true
  },

  // No database and no bucket, here or in development: the Worker serves the snapshot of its
  // API that `npm run snapshot` wrote into `web/public/api/`, built from `cv.db` and `github.db`.


  "observability": {
    "enabled": true
  }
}
