---
// `/kinoer`: the cinemas the owner has been to, most visited first, each a link to its own page.
import { readApi } from '@designsystem/config/astro-api'

import FilmPage from '@/layouts/FilmPage.astro'
import { RESPONSES } from '@/server/responses'
import { Cinemas } from '@/views/Cinemas'
import '../index.css'

const data = await readApi(Astro.url, 'cinemas', RESPONSES.cinemas)
---

<FilmPage>
  <Cinemas data={data} />
</FilmPage>
