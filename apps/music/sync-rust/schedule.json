{
  "requires": ["LASTFM_USER", "LASTFM_API_KEY", "DISCOGS_USER", "DISCOGS_KEY", "DISCOGS_SECRET", "LASTFM_API_SECRET", "SPOTIFY_CLIENT_ID", "SPOTIFY_CLIENT_SECRET"],
  "modes": {
    "daily": [
      "sync-lastfm",
      "split-podcasts",
      "feedback",
      "discogs",
      "resolve-musicbrainz 60",
      "enrich",
      "variants",
      "daily-plays current-year",
      "all-time-totals",
      "summaries current-year",
      "summaries rolling",
      "memories",
      "capsules",
      "entities",
      "spotify-recent",
      "spotify-likes",
      "likes-push 50"
    ],
    "backlog": [
      "resolve-albums 100",
      "enrich",
      "release-covers 300",
      "enrich-extra 120",
      "release-dates 300",
      "spotify-images 300",
      "spotify-album-images 300",
      "deezer-images 300",
      "album-tracklists 100"
    ],
    "concerts": ["import-concerts-calendar", "concert-photos"],
    "all": ["split-podcasts", "podcast-feeds", "podcast-countries", "variants", "daily-plays all", "summaries {mode}", "memories", "capsules", "entities", "spotify-library"],
    "years": ["split-podcasts", "variants", "daily-plays all", "summaries {mode}", "memories", "capsules", "entities"]
  },
  "timers": [
    { "name": "frequent", "description": "Sync new Last.fm scrobbles and recent summaries every three hours", "mode": "daily", "calendar": "*-*-* 00/3:17:00", "timeout": "30min" },
    { "name": "backlog", "description": "Work down the rate-limited lookups at MusicBrainz, Spotify and Deezer, an hour before the next frequent sync counts them in", "mode": "backlog", "calendar": "*-*-* 02/3:17:00", "timeout": "90min" },
    { "name": "concerts", "description": "Read the Konserter calendar, the Immich album of each concert and the favourite photos in it (or some from after the start); the calendar is exported on Sundays and the albums made at 04:34, so more often finds nothing new", "mode": "concerts", "calendar": "Mon *-*-* 05:30:00", "timeout": "5min" },
    { "name": "weekly", "description": "Recompute the whole listening history", "mode": "all", "calendar": "Mon *-*-* 04:47:00", "timeout": "15min" }
  ]
}
