---
// `/historikk?month=YYYY-MM`: every listen of one month, the newest without one.
import { notFoundPage, readApi } from '@designsystem/config/astro-api'
import { readPageIfPresent } from '@designsystem/config/astro-page-data'
import { historyRequest } from '@designsystem/ui/lib/page-requests'
import { MonthSearch } from '@designsystem/ui/lib/period-search'
import { whereOf } from '@designsystem/watch/where'
import * as v from 'valibot'

import MusicPage from '@/layouts/MusicPage.astro'
import { RESPONSES } from '@/server/responses'
import { History } from '@/views/History'
import '../index.css'

const search = v.parse(MonthSearch, Object.fromEntries(Astro.url.searchParams))
// A month the log has no file for is not a page.
const [data, index] = await Promise.all([readPageIfPresent(Astro.url, historyRequest(search), RESPONSES.history), readApi(Astro.url, 'entities', RESPONSES.entities)])
if (data === null) {
  Astro.cache.set(false)
  return notFoundPage()
}
---

<MusicPage>
  <History data={data} index={index} where={whereOf(Astro.url)} />
</MusicPage>
