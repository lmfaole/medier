---
// `/tilbakeblikk/uke`: the latest weeks of listening, one after the other, with what changed from week to week.
import { readApi } from '@designsystem/config/astro-api'
import { whereOf } from '@designsystem/watch/where'

import MusicPage from '@/layouts/MusicPage.astro'
import { RESPONSES } from '@/server/responses'
import { Weeks } from '@/views/Weeks'
import '../../index.css'

const [data, index] = await Promise.all([readApi(Astro.url, 'weeks', RESPONSES.weeks), readApi(Astro.url, 'entities', RESPONSES.entities)])
---

<MusicPage>
  <Weeks data={data} index={index} where={whereOf(Astro.url)} />
</MusicPage>
