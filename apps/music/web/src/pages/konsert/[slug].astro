---
// `/konsert/[slug]`: one concert's own page, with the picture of the artist it is named for when the library has that artist.
import { notFoundPage, readApi } from '@designsystem/config/astro-api'
import { readPageIfPresent } from '@designsystem/config/astro-page-data'
import { entityRequest } from '@designsystem/ui/lib/page-requests'
import { SlugParams } from '@designsystem/ui/lib/slug-params'
import { whereOf } from '@designsystem/watch/where'
import * as v from 'valibot'

import MusicPage from '@/layouts/MusicPage.astro'
import { RESPONSES } from '@/server/responses'
import { Concert } from '@/views/Concert'
import '../../index.css'

const params = v.safeParse(SlugParams, Astro.params)
const [data, index] = await Promise.all([readApi(Astro.url, 'concerts', RESPONSES.concerts), readApi(Astro.url, 'entities', RESPONSES.entities)])
const concert = params.success ? data.concerts.find((candidate) => candidate.slug === params.output.slug) : undefined
if (concert === undefined) {
  Astro.cache.set(false)
  return notFoundPage()
}
const artistSlug = index.find((entity) => entity.kind === 'artist' && entity.name === concert.artist)?.slug
const artistPage = artistSlug === undefined ? null : await readPageIfPresent(Astro.url, entityRequest(artistSlug, 'artist'), RESPONSES.entity)
const artist = artistPage?.kind === 'artist' ? artistPage : null
---

<MusicPage thing>
  <Concert concert={concert} artist={artist} index={index} where={whereOf(Astro.url)} client:visible />
</MusicPage>
