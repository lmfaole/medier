---
// `/album/[slug]`: one album's own page.
import { notFoundPage, readApi } from '@designsystem/config/astro-api'
import { readPageIfPresent } from '@designsystem/config/astro-page-data'
import { appUrl } from '@designsystem/ui/lib/base-url'
import { entityRequest } from '@designsystem/ui/lib/page-requests'
import { SlugParams } from '@designsystem/ui/lib/slug-params'
import { whereOf } from '@designsystem/watch/where'
import * as v from 'valibot'

import MusicPage from '@/layouts/MusicPage.astro'
import { RESPONSES } from '@/server/responses'
import { Entity } from '@/views/Entity'
import '../../index.css'

const params = v.safeParse(SlugParams, Astro.params)
const [page, index] = await Promise.all([
  params.success ? readPageIfPresent(Astro.url, entityRequest(params.output.slug, 'album'), RESPONSES.entity) : null,
  readApi(Astro.url, 'entities', RESPONSES.entities),
])
if (page === null) {
  Astro.cache.set(false)
  return notFoundPage()
}
// An old address of a page whose spellings were joined: go to the address it has now.
if (params.success && page.slug !== params.output.slug) return Astro.redirect(`${appUrl(`/album/${page.slug}`)}${Astro.url.search}`, 301)
---

<MusicPage thing>
  <Entity page={page} index={index} where={whereOf(Astro.url)} client:visible />
</MusicPage>
