---
// `/artist/[slug]`: one artist's own page.
import { notFoundPage, readApi } from '@designsystem/config/astro-api'
import { readPageIfPresent } from '@designsystem/config/astro-page-data'
import { appUrl } from '@designsystem/ui/lib/base-url'
import { entityRequest } from '@designsystem/ui/lib/page-requests'
import { SlugParams } from '@designsystem/ui/lib/slug-params'
import { whereOf } from '@designsystem/watch/where'
import * as v from 'valibot'

import { playedAt } from '@/lib/concert-label'
import MusicPage from '@/layouts/MusicPage.astro'
import { RESPONSES } from '@/server/responses'
import { Entity } from '@/views/Entity'
import '../../index.css'

const params = v.safeParse(SlugParams, Astro.params)
const [page, index, concertList] = await Promise.all([
  params.success ? readPageIfPresent(Astro.url, entityRequest(params.output.slug, 'artist'), RESPONSES.entity) : null,
  readApi(Astro.url, 'entities', RESPONSES.entities),
  // A snapshot has no concerts (they name places), so the row is left out there.
  readPageIfPresent(Astro.url, { file: 'concerts', params: {} }, RESPONSES.concerts),
])
if (page === null) {
  Astro.cache.set(false)
  return notFoundPage()
}
// An old address of a page whose spellings were joined: go to the address it has now.
if (params.success && page.slug !== params.output.slug) return Astro.redirect(`${appUrl(`/artist/${page.slug}`)}${Astro.url.search}`, 301)
const concerts = concertList?.concerts.filter((concert) => playedAt(concert, page.name)) ?? []
---

<MusicPage thing>
  <Entity page={page} index={index} where={whereOf(Astro.url)} concerts={concerts} client:visible />
</MusicPage>
