---
// `/bibliotek?q=&status=&kind=&format=`: every artist, album and song there is a page for, found and narrowed by the address.
import { readPage } from '@designsystem/config/astro-api'
import { libraryRequest } from '@designsystem/ui/lib/page-requests'

import MusicPage from '@/layouts/MusicPage.astro'
import { RESPONSES } from '@/server/responses'
import { Library } from '@/views/Library'
import '../index.css'

const data = await readPage(Astro.url, libraryRequest(), RESPONSES.library)
---

<MusicPage>
  <Library data={data} query={Astro.url.search} client:idle />
</MusicPage>
