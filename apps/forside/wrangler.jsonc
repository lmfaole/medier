{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forside",
  "main": "web/src/server.ts",
  "compatibility_date": "2026-10-04",
  // Astro on Workers needs AsyncLocalStorage, which comes with nodejs_compat.
  "compatibility_flags": ["nodejs_compat"],
  // Same account as every app, so `deploy` does not stop with "More than one
  // account available" in a non-interactive context.
  "account_id": "5d49b98b68b70cbd1c81be0f18501262",
  // The root of lmfaole.party. A zone route, not a custom domain, because the old addresses of the media apps
  // (`/medier/musikk/*`, now `sky.lmfaole.party/apps/medier/musikk/*`) are paths of this host that it redirects.
  "routes": [
    { "pattern": "lmfaole.party/*", "zone_name": "lmfaole.party" }
  ],
  // One address, no *.workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // The Worker runs for every request so the security headers apply.
    "run_worker_first": true
  },
  // No database and no bucket, here or in development: the Worker serves the snapshot of its API that
  // `npm run snapshot` wrote into `web/public/api/`, built from `music.db`, `podcasts.db`, `film.db`, `tv.db`, `games.db`, `books.db` and `boardgames.db`.
  "observability": {
    "enabled": true
  }
}
