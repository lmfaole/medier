---
export const prerender = true
// `/`: the front page, a name, one sentence and a few plain links.
import Document from '@designsystem/ui/layouts/document'

import { NAME, PROFILE, pageHead, pageOg } from '@/lib/profile'
import { Forside } from '@/views/Forside'
import '../index.css'

const page = pageHead('/')
---

<Document
  title={page.title}
  index
  og={pageOg('/')}
  jsonLd={{ '@context': 'https://schema.org', '@type': 'Person', name: NAME, url: PROFILE.url, image: `${PROFILE.url}profilbilde.jpg`, email: `mailto:${PROFILE.email}`, sameAs: [PROFILE.github, PROFILE.linkedin] }}
>
  <Forside />
</Document>
