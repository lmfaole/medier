---
// `/medier`: the apps and the log of what happened across them, read from the snapshot.
import { readApi } from '@designsystem/config/astro-api'
import { Text } from '@lmfaole/designsystem/components/text'
import Document from '@designsystem/ui/layouts/document'

import { pageHead, pageOg } from '@/lib/profile'
import Freshness from '@/components/Freshness.astro'
import { Media } from '@/views/Media'
import { RESPONSES } from '@designsystem/timeline/response'
import '../index.css'

const page = pageHead('/medier')
const timeline = await readApi(Astro.url, 'timeline', RESPONSES.timeline)
---

<Document title={page.title} index og={pageOg('/medier')}>
  <Media timeline={timeline}>
    <Freshness server:defer>
      <Text slot="fallback" size="sm" tone="muted">&nbsp;</Text>
    </Freshness>
  </Media>
</Document>
