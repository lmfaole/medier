---
/**
 * A page of the podkast app: the shared page frame (menu, the foot of the page) with the head from
 * `og-pages.json`.
 */
import AppPage from '@designsystem/ui/layouts/app-page'
import { pageHeadOf } from '@designsystem/ui/lib/page-head'

interface Props {
  /** The document title of a page no `og-pages.json` row covers (a show's or an episode's own page). */
  title?: string
  /** The page of one thing: no sentence about the data under it (`AppPage`'s `thing`). */
  thing?: boolean
}

const head = pageHeadOf('podkast', Astro.url, Astro.props.title ?? 'Podkast')
---

<AppPage app="podkast" title={head.title} og={head.og} thing={Astro.props.thing}>
  <slot />
</AppPage>
