---
// `/`: the front page of the podcast log. Plain HTML.
import { readPage } from '@designsystem/config/astro-api'
import { overviewRequest } from '@designsystem/ui/lib/page-requests'

import PodkastPage from '@/layouts/PodkastPage.astro'
import { RESPONSES } from '@/server/responses'
import { Overview } from '@/views/Overview'
import '../index.css'

const data = await readPage(Astro.url, overviewRequest(), RESPONSES.overview)
---

<PodkastPage>
  <Overview data={data} />
</PodkastPage>
