#!/bin/sh
# The design system's one hard rule (docs/UI-COMPONENTS.md): no app under apps/*/web/src styles itself, no
# className, class or style, and an index.css that only imports the theme. The same test CI runs
# (scripts/design-system.test.ts) and the one way a time is written, Norwegian in Oslo (scripts/time-format.test.ts), run on every commit for every app: it reads the files, not a model's
# opinion, and takes a tenth of a second, so a violation stops here and not at the push.
# `git commit --no-verify` skips this. Turned on by `npm install` (the root `prepare` script).
set -e
cd "$(git rev-parse --show-toplevel)"
log=$(mktemp)
trap 'rm -f "$log"' EXIT
node --test scripts/design-system.test.ts scripts/time-format.test.ts > "$log" 2>&1 || {
  cat "$log"
  echo "pre-commit: an app styles itself or formats a time itself. Markup goes in packages/ui (docs/UI-COMPONENTS.md); a time goes through formatTime or <Time> (packages/intl/src/time.ts)." >&2
  exit 1
}
