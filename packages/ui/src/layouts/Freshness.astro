---
/**
 * The sentence about when the data last arrived, as a server island (`server:defer` in `AppPage`): the page around it is kept at
 * the edge for minutes, this line is read from the snapshot on its own request and is never kept. An app with no sync has no
 * `oppdatert.json` and the island answers with nothing.
 */
import { readFreshness } from '@designsystem/config/astro-page-data'

import { freshnessSentence } from '../lib/freshness'

const freshness = await readFreshness(Astro.url)
Astro.cache.set(false)
---

{freshness === null ? null : <p class="text-muted-foreground mt-12 text-sm">{freshnessSentence(freshness)}</p>}
