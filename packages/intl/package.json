{
  "name": "@designsystem/intl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared date, number and plural formatting for the designsystem's apps, built only on the platform's Intl objects",
  "scripts": {
    "test": "node --test",
    "lint": "oxlint -c ../config/oxlintrc.json src",
    "typecheck": "tsc --noEmit -p tsconfig.json --tsBuildInfoFile node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "exports": {
    "./date": "./src/date.ts",
    "./listening": "./src/listening.ts",
    "./number": "./src/number.ts",
    "./plural": "./src/plural.ts",
    "./podcast-covers": "./src/podcast-covers.ts",
    "./text": "./src/text.ts",
    "./time": "./src/time.ts"
  }
}
