{
  "name": "@designsystem/shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The counting and the pages shared by the shelf apps (games, books, board games): one log of what was played or read, counted the same way",
  "scripts": {
    "lint": "oxlint -c ../config/oxlintrc.json src",
    "typecheck": "tsc --noEmit -p tsconfig.json --tsBuildInfoFile node_modules/.tmp/tsconfig.tsbuildinfo",
    "test": "node --test"
  },
  "exports": {
    "./shelf": "./src/shelf.ts",
    "./api": "./src/api.ts",
    "./words": "./src/words.ts",
    "./covers": "./src/covers.ts",
    "./entity-model": "./src/pages/entity-model.ts",
    "./entity": "./src/pages/entity.tsx",
    "./overview": "./src/pages/overview.tsx",
    "./pages/*": "./src/pages/*.tsx",
    "./responses": "./src/responses.ts",
    "./views": "./src/views.tsx",
    "./here": "./src/here.ts",
    "./links": "./src/links.tsx",
    "./layouts/shelf-page": "./src/layouts/ShelfPage.astro"
  },
  "dependencies": {
    "@lmfaole/designsystem": "github:lmfaole/designsystem#1b6328c2b413c93250031321a5f0e86bc1e77c45",
    "@designsystem/config": "*",
    "@designsystem/contracts": "*",
    "@designsystem/intl": "*",
    "@designsystem/ui": "*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18"
  }
}
