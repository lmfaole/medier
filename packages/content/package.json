{
  "name": "@designsystem/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The content as rows: the collection specs, the row schemas and types, the tables and how a row is read",
  "scripts": {
    "test": "node --test",
    "lint": "oxlint -c ../config/oxlintrc.json src",
    "typecheck": "tsc --noEmit -p tsconfig.json --tsBuildInfoFile node_modules/.tmp/tsconfig.tsbuildinfo",
    "generate": "node scripts/generate.ts"
  },
  "exports": {
    "./spec": "./src/spec.ts",
    "./collections": "./src/collections.ts",
    "./slug": "./src/slug.ts",
    "./rows": "./src/generated/rows.ts",
    "./read-database": "./src/read-database.ts",
    "./to-sql": "./src/to-sql.ts",
    "./tables": "./src/tables.ts",
    "./row-types": "./src/row-types.ts"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@designsystem/config": "*",
    "@types/node": "^24.13.3",
    "typescript": "~7.0.2",
    "oxlint": "^1.81.0"
  }
}
