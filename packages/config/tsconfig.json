{
  // This package's own sources and tests. They run in a Worker (the request
  // pipeline) and in Node (the Vite presets, the deploy checks), so both the
  // DOM's fetch types and Node's are in scope; `cloudflare-workers.d.ts`
  // adds the Workers-only bindings. The `types` come from the base above.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["*.ts"]
}
