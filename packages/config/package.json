{
  "name": "@designsystem/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript, oxlint and Vite configuration, and the Worker pipeline, for the designsystem's apps",
  "scripts": {
    "test": "node --test",
    "lint": "oxlint -c oxlintrc.json *.ts pwa/*.ts",
    "typecheck": "tsc -p tsconfig.json --tsBuildInfoFile node_modules/.tmp/tsconfig.tsbuildinfo && tsc -p pwa/tsconfig.json --tsBuildInfoFile node_modules/.tmp/pwa.tsbuildinfo"
  },
  "exports": {
    "./astro-preset": "./astro-preset.ts",
    "./astro-worker": "./astro-worker.ts",
    "./astro-render": "./astro-render.ts",
    "./astro-api": "./astro-api.ts",
    "./astro-page-data": "./astro-page-data.ts",
    "./snapshot-read": "./snapshot-read.ts",
    "./api-fetchers": "./api-fetchers.ts",
    "./login-gate": "./login-gate.ts",
    "./host-fetch": "./host-fetch.ts",
    "./indexable-astro-worker": "./indexable-astro-worker.ts",
    "./og-tags": "./og-tags.ts",
    "./security-headers": "./security-headers.ts",
    "./dev-flag": "./dev-flag.ts",
    "./prompt": "./prompt.ts",
    "./asset-id": "./asset-id.ts",
    "./artist-image": "./artist-image.ts",
    "./backdrop-source": "./backdrop-source.ts",
    "./cinema-image": "./cinema-image.ts",
    "./cover-archive": "./cover-archive.ts",
    "./poster-source": "./poster-source.ts",
    "./edge-cache": "./edge-cache.ts",
    "./worker-app": "./worker-app.ts",
    "./json-response": "./json-response.ts",
    "./static-json-files": "./static-json-files.ts",
    "./api-files": "./api-files.ts",
    "./apper-files": "./apper-files.ts",
    "./snapshot-files": "./snapshot-files.ts",
    "./d1-query": "./d1-query.ts",
    "./d1-read-once": "./d1-read-once.ts",
    "./asset-json": "./asset-json.ts",
    "./cloudflare-env": "./cloudflare-env.ts",
    "./moved-pages": "./moved-pages.ts",
    "./worker-test-kit": "./worker-test-kit.ts",
    "./inline-script-hashes": "./inline-script-hashes.ts",
    "./json-safe": "./json-safe.ts",
    "./error-pages": "./error-pages.ts",
    "./bindings-config": "./bindings-config.ts",
    "./sqlite-d1": "./sqlite-d1.ts",
    "./sql-dump": "./sql-dump.ts",
    "./tsconfig/app.json": "./tsconfig.app.json",
    "./tsconfig/node.json": "./tsconfig.node.json",
    "./tsconfig/worker.json": "./tsconfig.worker.json",
    "./cloudflare-workers.d.ts": "./cloudflare-workers.d.ts",
    "./oxlintrc.json": "./oxlintrc.json",
    "./pwa/share-files": "./pwa/share-files.ts",
    "./pwa/sw-app-share": "./pwa/sw-app-share.ts",
    "./pwa/fake-idb": "./pwa/fake-idb.ts",
    "./app-shell/api": "./app-shell/lib/api.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/node": "^11.1.11",
    "@astrojs/react": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.5",
    "valibot": "^1.5.0"
  }
}
