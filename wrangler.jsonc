{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medier",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Only the custom domain: no workers.dev or preview address, so the site has one address.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Whose plays and viewings are shown is the visitor's (their usernames, in cookies), never a setting. The keys, and the address of the relay, are secrets (`src/lib/settings.ts`).
  "routes": [{ "pattern": "medier.lmfaole.party", "custom_domain": true }]
}
