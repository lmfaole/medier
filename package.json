{
  "name": "medier",
  "private": true,
  "type": "module",
  "description": "Hva jeg hører på og ser: en statisk side bygget av GitHub Actions fra Last.fm og Trakt",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "fetch": "node scripts/fetch.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "skills": "designsystem-skills",
    "skills:check": "designsystem-skills --check",
    "ds:bump": "designsystem-bump",
    "settings:push": "node scripts/settings.ts push",
    "settings:check": "node scripts/settings.ts check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@lmfaole/designsystem": "github:lmfaole/designsystem#ba0ba800a05adb9b0742cdb994248a4816234d59",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "~7.0.2"
  }
}
