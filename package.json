{
  "name": "medier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "lmfaole.party sine offentlige apper: medier (musikk, podkast, film, tv, spill, bøker, brettspill), forsiden og CV-en",
  "workspaces": [
    "packages/*",
    "apps/*/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "node scripts/run-apps.ts build",
    "lint": "npm run lint --workspace packages/ui --workspace packages/contracts --workspace packages/content --workspace packages/config --workspace packages/intl --workspace packages/watch --workspace packages/shelf && npx oxlint -c packages/config/oxlintrc.json scripts e2e playwright.config.ts && node scripts/run-apps.ts lint",
    "typecheck": "node scripts/run-parallel.ts \"npm run -s typecheck --workspace packages/ui\" \"npm run -s typecheck --workspace packages/contracts\" \"npm run -s typecheck --workspace packages/content\" \"npm run -s typecheck --workspace packages/config\" \"npm run -s typecheck --workspace packages/intl\" \"npm run -s typecheck --workspace packages/watch\" \"npm run -s typecheck --workspace packages/shelf\" \"npx tsc -p scripts --tsBuildInfoFile node_modules/.tmp/scripts.tsbuildinfo\" \"npx tsc -p e2e --tsBuildInfoFile node_modules/.tmp/e2e.tsbuildinfo\" \"node scripts/run-apps.ts typecheck\"",
    "check": "node scripts/run-apps.ts check",
    "media:build": "node scripts/media-build.ts",
    "media:start": "node scripts/media-server.ts",
    "check:bundles": "node scripts/check-bundles.ts",
    "dupes": "jscpd",
    "verify": "node scripts/verify.ts",
    "skills": "designsystem-skills",
    "skills:check": "designsystem-skills --check",
    "ds:bump": "designsystem-bump",
    "affected": "node scripts/affected.ts",
    "ship": "node scripts/ship.ts",
    "data:describe": "node --no-warnings scripts/data.ts describe",
    "data:status": "node --no-warnings scripts/data.ts status",
    "page-check": "node --no-warnings scripts/page-check.ts",
    "land": "node --no-warnings scripts/land.ts",
    "repo:map": "node scripts/repo-map.ts",
    "data:refresh": "node --no-warnings scripts/data-refresh.ts",
    "data:query": "node --no-warnings scripts/data.ts query",
    "data:dump": "node --no-warnings scripts/data-dump.ts dump",
    "data:restore": "node --no-warnings scripts/data-dump.ts restore",
    "data:check": "node --no-warnings scripts/data-check.ts",
    "data:rehearse": "node --no-warnings scripts/data-rehearse.ts",
    "film:inbox": "node --no-warnings scripts/film-inbox.ts",
    "data:migrate": "cargo run -q -p data-migrate",
    "deploy:all": "node scripts/run-apps.ts deploy",
    "test": "node --test",
    "dev:all": "node scripts/dev-all.ts",
    "e2e": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 playwright test --project=chromium --project=mobile-chromium",
    "dev:music": "npm run dev --workspace apps/music/web",
    "e2e:all": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 playwright test --project=chromium --project=mobile-chromium --project=firefox --project=webkit --project=mobile-webkit",
    "e2e:screenshots": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 playwright test --project=screenshots-desktop --project=screenshots-mobile",
    "log:settle": "node --no-warnings scripts/log-settle.ts",
    "cover:colors": "node --no-warnings scripts/cover-colors.ts",
    "venue:maps": "node --no-warnings scripts/venue-maps.ts",
    "concert:albums": "node --no-warnings scripts/concert-albums.ts",
    "concert:album": "node --no-warnings scripts/concert-album.ts",
    "log:remove": "node --no-warnings scripts/log-remove.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "imapflow": "^2.9.1",
    "jscpd": "^5.4.0",
    "postal-mime": "^4.1.4",
    "web-push": "^4.0.0"
  }
}
