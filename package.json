{
  "name": "medier",
  "private": true,
  "type": "module",
  "description": "Hva jeg hører på og ser: en side på Cloudflare Workers som spør Last.fm, Spotify og Trakt",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy && wrangler deploy --config upstream/wrangler.jsonc",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "skills": "designsystem-skills",
    "skills:check": "designsystem-skills --check",
    "ds:bump": "designsystem-bump",
    "settings:push": "node scripts/settings.ts push",
    "spotify:auth": "node scripts/spotify-auth.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.2",
    "@lmfaole/designsystem": "github:lmfaole/designsystem#a72b56080bc71ba08c8a74b131e47132f529c14d",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.165.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "~7.0.2"
  }
}
