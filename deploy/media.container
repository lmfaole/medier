# DRAFT for the move to the image: the media server from ghcr.io/lmfaole/medier instead of the checkout of the monorepo. It replaces
# quadlets/media.container in the Nextcloud repository once the home apps have a container of their own (they are not in this image);
# until then the old unit stays. Install: copy to ~/.config/containers/systemd/media.container, systemctl --user daemon-reload,
# systemctl --user restart media, and once: systemctl --user enable --now podman-auto-update.timer.

[Unit]
Description=Media apps (music, podkast, film, tv, games, books, boardgames and the hub): the image of lmfaole/medier
After=nextcloud.service
Wants=nextcloud.service

[Container]
ContainerName=media
Image=ghcr.io/lmfaole/medier:latest
# podman-auto-update.timer pulls :latest when the registry has a newer one (a green push to main) and restarts the unit; a new image that
# fails its health check is rolled back to the one before.
AutoUpdate=registry
# Reached as http://media:3000 by cloudflared-immich (and Uptime Kuma) over nextcloud.network; no published port.
Network=nextcloud.network
# Container uid = host uid (1000, the image's user node): the databases are owned by lmfaole and open with no uid shifting.
UserNS=keep-id

Environment=NEXTCLOUD_URL=http://nextcloud:80
Environment=NEXTCLOUD_HOST=sky.lmfaole.party
Environment=OWNER_UID=ole
Environment=HOME=/tmp
# The pictures landed on the machine (covers, posters, artists under apps/<app>/web/public/) are not in the image; the server serves them from here.
Environment=PICTURES_DIR=/pictures
# PORT, DATA_DIR=/data, NODE_ENV, TZ and NODE_OPTIONS come from the image.

# SELinux: .data (with the raw originals) is not relabelled at every start, so label confinement is off for this container. Compensation:
# everything is read-only but the databases' folder, no capabilities, no new privileges, and the image holds no key.
SecurityLabelDisable=true

# The one writable mount: SQLite in WAL mode makes a reader create/open <db>-shm, and a reader on a read-only mount fails with "unable to open
# database file" when none exists. The server opens every database read-only (readOnly: true), so it still cannot change a table.
Volume=/home/lmfaole/Applikasjoner/Documents/monorepo/.data:/data
# Everything in .data that is not a database stays read-only.
Volume=/home/lmfaole/Applikasjoner/Documents/monorepo/.data/raw:/data/raw:ro
Volume=/home/lmfaole/Applikasjoner/Documents/monorepo/.data/archive:/data/archive:ro
Volume=/home/lmfaole/Applikasjoner/Documents/monorepo/.data/published:/data/published:ro
Volume=/home/lmfaole/Applikasjoner/Documents/monorepo/.data/profile:/data/profile:ro
Volume=/home/lmfaole/Applikasjoner/Documents/monorepo/.data/tmp:/data/tmp:ro
# The checkout's apps/, read-only, for its landed pictures only (PICTURES_DIR). After the move, the checkout of lmfaole/medier on the machine.
Volume=/home/lmfaole/Applikasjoner/Documents/monorepo/apps:/pictures:ro
ReadOnly=true
Tmpfs=/tmp:rw,size=256m
DropCapability=ALL
NoNewPrivileges=true

# With one worker thread per app the server sits at ~730 MB and peaked at 1.4 GB; each worker is capped at 1 GB heap.
Memory=3g
PidsLimit=256

# The check waits for Node to listen (up to 20 s) so a start or an auto-update is not a false failure; a hung server still fails.
HealthCmd=node -e "const t=Date.now();(async()=>{for(;;){try{if((await fetch('http://127.0.0.1:3000/healthz',{signal:AbortSignal.timeout(2000)})).ok)process.exit(0)}catch{}if(Date.now()-t>20000)process.exit(1);await new Promise(r=>setTimeout(r,500))}})()"
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3
HealthStartPeriod=30s

[Service]
Restart=always
SuccessExitStatus=143
RestartSec=10
TimeoutStartSec=5min

[Install]
WantedBy=default.target
