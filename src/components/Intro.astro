---
// The intro of a page, the first time it is visited: left out by the server once dismissed (the `seen` cookie), so it never flashes.
import { IntroCallout } from '@lmfaole/designsystem/components/intro-callout'
import { isSeen, parseSeen, SEEN_COOKIE } from '@lmfaole/designsystem/lib/onboarding'
import { type Intro, SEEN_PATH } from '../lib/onboarding'

interface Props {
  intro: Intro
  action?: { href: string; label: string }
}

const { intro, action } = Astro.props
const version = intro.version ?? 1
const seen = isSeen(parseSeen(Astro.cookies.get(SEEN_COOKIE)?.value), intro.id, version)
---

{!seen && <IntroCallout client:idle id={intro.id} version={version} seen={false} title={intro.title} body={intro.body} cookiePath={SEEN_PATH} {...(action === undefined ? {} : { action })} />}
