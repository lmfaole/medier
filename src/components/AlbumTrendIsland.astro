---
// A server island in the head: the line beside the album's plays is its plays over time, the same weekly album charts as «Din lytting» (kept, so the two share them).
import { listeningChartText } from '../lib/artist-listening'
import { albumTimeline, usersOf } from '../lib/runtime'
import { Sparkline } from '@lmfaole/designsystem/components/sparkline'

interface Props {
  artist: string
  title: string
}

const { artist, title } = Astro.props
const timeline = await albumTimeline(usersOf(Astro.cookies), artist, title)
const chart = timeline === null || timeline.series.every((one) => one.plays === 0) ? null : listeningChartText(timeline.unit, timeline.series)
---

{timeline !== null && chart !== null && <Sparkline values={timeline.series.map((one) => one.plays)} label={`${chart.description} ${chart.title}.`} />}
