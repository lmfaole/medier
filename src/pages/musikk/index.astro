---
import Intro from '../../components/Intro.astro'
import { INTROS } from '../../lib/onboarding'
import { PageSection } from '@lmfaole/designsystem/components/page-section'
import { mediumHref } from '../../lib/media'
import { monthAt } from '../../lib/months'

import { Fetched, PlayRows, TopArtistRows } from '../../components/sections'
import UsernameGate from '../../components/UsernameGate.astro'
import Page from '../../layouts/Page.astro'
import { playingNow } from '../../lib/now'
import { artistPictures, music, usersOf } from '../../lib/runtime'

const base = import.meta.env.BASE_URL
const users = usersOf(Astro.cookies)
const { listening, pictures } = users.lastfm === null ? { listening: null, pictures: new Map() } : await music(users).then(async (found) => ({ listening: found, pictures: await artistPictures((found?.topArtists ?? []).map((artist) => artist.name)) }))
const now = playingNow(listening?.now ?? null)
---

<Page current="music" title="Musikk" lead="De siste avspillingene og de mest spilte artistene siste måned, fra Last.fm.">
  {
    users.lastfm === null ? (
      <UsernameGate services={['lastfm']} />
    ) : (
      <>
        <Intro intro={INTROS.musikk} />
        <PageSection id="siste" title="Siste avspillinger" continues={{ href: mediumHref(base, 'music', 'historikk/'), label: 'Se hele lyttehistorikken' }}>
          <PlayRows plays={(listening?.recent ?? []).slice(0, 10)} now={now} base={base} />
        </PageSection>
        <PageSection id="artister" title="Mest spilt siste måned" continues={{ href: mediumHref(base, 'music', 'maned/', monthAt(Date.now()).id), label: 'Se månedens Wrapped' }}>
          <TopArtistRows artists={listening?.topArtists ?? []} base={base} pictures={pictures} />
        </PageSection>
        <Fetched sources={[{ at: listening?.at ?? null, source: 'Last.fm' }]} />
      </>
    )
  }
</Page>
