---
import { PageSection } from '@lmfaole/designsystem/components/page-section'

import { Fetched, PlayRows, TopArtistRows } from '../../components/sections'
import Page from '../../layouts/Page.astro'
import { playingNow } from '../../lib/now'
import { artistPictures, music, spotifyNow } from '../../lib/runtime'

const base = import.meta.env.BASE_URL
const withPictures = music().then(async (found) => ({ listening: found, pictures: await artistPictures((found?.topArtists ?? []).map((artist) => artist.name)) }))
const [{ listening, pictures }, spotify] = await Promise.all([withPictures, spotifyNow()])
const now = playingNow(spotify, listening?.now ?? null)
---

<Page current="music" title="Musikk" lead="De siste avspillingene og de mest spilte artistene siste måned, fra Last.fm og Spotify." crumbs={[{ label: 'Medier', href: base }, { label: 'Musikk', href: `${base}musikk/` }]}>
  <PageSection id="siste" title="Siste avspillinger">
    <PlayRows plays={listening?.recent ?? []} now={now} base={base} />
  </PageSection>
  <PageSection id="artister" title="Mest spilt siste måned">
    <TopArtistRows artists={listening?.topArtists ?? []} base={base} pictures={pictures} />
  </PageSection>
  <Fetched sources={[{ at: listening?.at ?? null, source: 'Last.fm' }]} />
</Page>
