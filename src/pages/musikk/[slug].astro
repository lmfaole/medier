---
import { ArtistDetail } from '../../components/detail'
import { Head } from '../../components/head'
import Page from '../../layouts/Page.astro'
import { artistPages } from '../../lib/pages'
import { artist, music } from '../../lib/runtime'

const listening = await music()
const page = listening === null ? undefined : artistPages(listening).find((one) => one.slug === Astro.params.slug)
if (page === undefined) return Astro.rewrite('/404/')
const info = await artist(page.name)
const base = import.meta.env.BASE_URL
---

<Page bare current="music" width="pane" title={page.name} lead="Artist" crumbs={[{ label: 'Medier', href: base }, { label: 'Musikk', href: `${base}musikk/` }, { label: page.name, href: `${base}musikk/${page.slug}/` }]}>
  <Head client:idle kind="Artist" title={page.name} sources={info.spotify?.images ?? []} shape="artist" fromSpotify={info.spotify !== null && info.spotify.images.length > 0} />
  <ArtistDetail page={page} base={base} info={info} />
</Page>
