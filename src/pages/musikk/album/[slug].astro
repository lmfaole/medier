---
import { AlbumDetail } from '../../../components/detail'
import { Head } from '../../../components/head'
import { sourcesOf } from '../../../lib/image-sources'
import NeedsUsername from '../../../components/NeedsUsername.astro'
import Page from '../../../layouts/Page.astro'
import { albumHref, albumPages, artistHref, trackPages } from '../../../lib/pages'
import { album, music, usersOf } from '../../../lib/runtime'

const users = usersOf(Astro.cookies)
const listening = users.lastfm === null ? null : await music(users)
const page = listening === null ? undefined : albumPages(listening).find((one) => one.slug === Astro.params.slug)
if (users.lastfm !== null && page === undefined) return Astro.rewrite('/404/')
const info = page === undefined ? null : await album(users, page.artist, page.title)
const played = new Set(listening === null ? [] : trackPages(listening).map((track) => track.slug))
const base = import.meta.env.BASE_URL
---

{page === undefined || info === null ? (
  <NeedsUsername medium="music" />
) : (
<Page
  bare
  current="music"
  width="pane"
  title={page.title}
  lead={`Album av ${page.artist}`}
  crumbs={[{ label: 'Medier', href: base }, { label: 'Musikk', href: `${base}musikk/` }, { label: page.artist, href: artistHref(base, page.artist) }, { label: page.title, href: albumHref(base, page.artist, page.title) }]}
>
  <Head client:idle kind="Album" title={page.title} sources={sourcesOf(page.image)} shape="album" sleeve by={{ name: page.artist, href: artistHref(base, page.artist) }} />
  <AlbumDetail page={page} base={base} info={info} played={played} />
</Page>
)}
