---
import { AlbumDetail, AlbumFacts, albumFactsOf } from '../../../components/detail'
import AlbumFactsIsland from '../../../components/AlbumFactsIsland.astro'
import AlbumListeningIsland from '../../../components/AlbumListeningIsland.astro'
import AlbumReleaseIsland from '../../../components/AlbumReleaseIsland.astro'
import { SectionSkeleton } from '@lmfaole/designsystem/components/section-skeleton'
import { albumKey } from '../../../lib/albums'
import { Head } from '../../../components/head'
import { sourcesOf } from '../../../lib/image-sources'
import NeedsUsername from '../../../components/NeedsUsername.astro'
import Page from '../../../layouts/Page.astro'
import { albumHref, albumPages, artistHref, trackPages } from '../../../lib/pages'
import { album, music, usersOf } from '../../../lib/runtime'

const users = usersOf(Astro.cookies)
const listening = users.lastfm === null ? null : await music(users)
const page = listening === null ? undefined : albumPages(listening).find((one) => one.slug === Astro.params.slug)
if (users.lastfm !== null && page === undefined) return Astro.rewrite('/404/')
const info = page === undefined ? null : await album(users, page.artist, page.title)
const played = new Set(listening === null ? [] : trackPages(listening).map((track) => track.slug))
const base = import.meta.env.BASE_URL
// The artist's albums that have a page here, under the title each was played under: the discography links to them.
const linked: [string, string][] = page === undefined || listening === null ? [] : [...new Map(albumPages(listening).filter((one) => one.artist === page.artist).map((one) => [albumKey(one.title), one.title]))]
---

{page === undefined || info === null ? (
  <NeedsUsername medium="music" />
) : (
<Page
  bare
  current="music"
  width="pane"
  title={page.title}
  lead={`Album av ${page.artist}`}
  crumbs={[{ label: 'Medier', href: base }, { label: 'Musikk', href: `${base}musikk/` }, { label: page.artist, href: artistHref(base, page.artist) }, { label: page.title, href: albumHref(base, page.artist, page.title) }]}
>
  <Head client:idle kind="Album" title={page.title} sources={sourcesOf(page.image)} shape="album" sleeve by={{ name: page.artist, href: artistHref(base, page.artist) }} />
  <AlbumDetail page={page} base={base} info={info} played={played}>
    <AlbumFactsIsland slot="facts" server:defer facts={albumFactsOf(page, info)} artist={page.artist} title={page.title} base={base}>
      <AlbumFacts slot="fallback" facts={albumFactsOf(page, info)} base={base} />
    </AlbumFactsIsland>
    <AlbumListeningIsland slot="chart" server:defer artist={page.artist} title={page.title}>
      <SectionSkeleton slot="fallback" title="lyttingen din over tid" lines={6} />
    </AlbumListeningIsland>
    <AlbumReleaseIsland slot="release" server:defer artist={page.artist} title={page.title} base={base} linked={linked}>
      <SectionSkeleton slot="fallback" title="medvirkende og utgaver fra MusicBrainz" lines={6} />
    </AlbumReleaseIsland>
  </AlbumDetail>
</Page>
)}
