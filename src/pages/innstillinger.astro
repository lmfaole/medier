---
// «Innstillinger»: the same choices as the first-run wizard, in sections on one page and one form (no JS needed), and «Vis introen igjen». «Bytt» by the usernames at the foot of every page leads here,
// with the page it came from in `tilbake`; once saved, a word that it is, and the way back there.
import { Banner } from '@lmfaole/designsystem/components/banner'
import { Button } from '@lmfaole/designsystem/components/button'
import { EffectsPreview } from '@lmfaole/designsystem/components/effects-preview'
import { SettingsSection } from '@lmfaole/designsystem/components/settings-section'
import { TextLink } from '@lmfaole/designsystem/components/text'
import { TiltPreview } from '@lmfaole/designsystem/components/tilt-preview'
import { parsePrefs, PREFS_COOKIE } from '@lmfaole/designsystem/lib/preferences'
import { SettingsForm } from '../components/settings-fields'
import Page from '../layouts/Page.astro'
import { usersOf } from '../lib/runtime'
import { formError, safeBack, usernameFields } from '../lib/users'

const base = import.meta.env.BASE_URL
const to = safeBack(Astro.url.searchParams.get('tilbake'), base)
const error = formError(Astro.url.searchParams)
const saved = Astro.url.searchParams.has('lagret') && error === null
const users = usersOf(Astro.cookies)
const [lastfm, trakt] = usernameFields(['lastfm', 'trakt'], users, error)
const prefs = parsePrefs(Astro.cookies.get(PREFS_COOKIE)?.value)
const back = `${base}innstillinger/?${new URLSearchParams({ tilbake: to, lagret: '1' }).toString()}`
const action = `${base}api/innstillinger/`
---

<Page firstRun={false} title="Innstillinger" lead="Hvem siden henter data for, hva forsiden viser, og hvordan den ser ut. Valgene lagres i informasjonskapsler i denne nettleseren." crumbs={[{ label: 'Medier', href: base }, { label: 'Innstillinger', href: `${base}innstillinger/` }]}>
  {
    saved && (
      <Banner tone="info" title="Innstillingene er lagret.">
        <TextLink href={to}>Tilbake til siden du var på</TextLink>
      </Banner>
    )
  }
  {lastfm !== undefined && trakt !== undefined && (
    <SettingsForm action={action} back={back} lastfm={lastfm} trakt={trakt} prefs={prefs}>
      <EffectsPreview slot="effectsPreview" client:visible value={prefs.effects} />
      <TiltPreview slot="tiltPreview" client:visible />
    </SettingsForm>
  )}
  <SettingsSection id="introen" title="Introen" body="Introen du fikk første gang, med de samme valgene ett og ett. Den åpner seg på forsiden.">
    <form method="post" action={action}>
      <input type="hidden" name="back" value={base} />
      <Button type="submit" name="rerun" value="1" variant="outline">Vis introen igjen</Button>
    </form>
  </SettingsSection>
</Page>
