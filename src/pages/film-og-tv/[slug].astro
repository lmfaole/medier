---
import { TitleDetail } from '../../components/detail'
import Page from '../../layouts/Page.astro'
import { titleHref, titlePages } from '../../lib/pages'
import { watched } from '../../lib/runtime'

const seen = await watched()
const page = seen === null ? undefined : titlePages(seen.items).find((one) => one.slug === Astro.params.slug)
if (page === undefined) return Astro.rewrite('/404/')
const base = import.meta.env.BASE_URL
const kind = page.kind === 'film' ? 'Film' : 'Serie'
---

<Page
  width="pane"
  title={page.title}
  lead={page.year === null ? kind : `${kind} · ${page.year}`}
  crumbs={[{ label: 'Medier', href: base }, { label: 'Film og TV', href: `${base}film-og-tv/` }, { label: page.title, href: titleHref(base, page.slug) }]}
>
  <TitleDetail page={page} base={base} />
</Page>
