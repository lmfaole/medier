---
import watched from '../../../data/watched.json'
import { TitleDetail } from '../../components/detail'
import Page from '../../layouts/Page.astro'
import { titleHref, titlePages, type TitlePage } from '../../lib/pages'
import type { Watched } from '../../lib/trakt'

export function getStaticPaths() {
  const seen: Watched = watched
  return titlePages(seen.items).map((page) => ({ params: { slug: page.slug }, props: { page } }))
}

const { page } = Astro.props as { page: TitlePage }
const base = import.meta.env.BASE_URL
const kind = page.kind === 'film' ? 'Film' : 'Serie'
---

<Page
  title={page.title}
  lead={page.year === null ? kind : `${kind} · ${page.year}`}
  crumbs={[{ label: 'Medier', href: base }, { label: 'Film og TV', href: `${base}film-og-tv/` }, { label: page.title, href: titleHref(base, page.slug) }]}
>
  <TitleDetail page={page} />
</Page>
