---
import { OtherPeriods, PeriodChips, PeriodView } from '../../components/wrapped'
import Page from '../../layouts/Page.astro'
import { albumPages, artistPages, titlePages, trackPages } from '../../lib/pages'
import { artistPictures, music, trend, watched, week as loadWeek } from '../../lib/runtime'
import { PlaysChart } from '../../components/trend'
import { TREND_LENGTH, trendColumns, weeksUpTo } from '../../lib/trend'
import { isComplete, parseWeek, rangeText, recentWeeks, weekAt } from '../../lib/weeks'

const base = import.meta.env.BASE_URL
const now = Date.now()
const week = parseWeek(Astro.params.week ?? '')
// A week that has not begun has nothing to tell, and an address that is no week is no page.
if (week === null || week.start * 1000 > now) return Astro.rewrite('/404/')
const [data, listening, seen] = await Promise.all([loadWeek(week), music(), watched()])
if (data === null) return Astro.rewrite('/404/')
// What has a page of its own to link to: among the recent plays (artists, albums, songs) and the films and shows seen.
const links = {
  artists: new Set(listening === null ? [] : artistPages(listening).map((page) => page.name)),
  albums: new Set(listening === null ? [] : albumPages(listening).map((page) => page.slug)),
  tracks: new Set(listening === null ? [] : trackPages(listening).map((page) => page.slug)),
  titles: new Map(seen === null ? [] : titlePages(seen.items).map((page) => [page.title, page.slug] as const)),
}
const pictures = await artistPictures((data.music?.stats.topArtists ?? []).map((artist) => artist.name))
const current = weekAt(now).id
const weeks = recentWeeks(now, 12).map((one) => ({ key: one.id, label: `Uke ${one.number}${one.id === current ? ' (så langt)' : ''}`, range: rangeText(one), href: `${base}uke/${one.id}/` }))
const complete = isComplete(week, now)
const span = weeksUpTo(week, TREND_LENGTH)
const points = await trend(span)
const columns = trendColumns(points ?? [], (id) => `u${span.find((one) => one.id === id)?.number ?? ''}`)
---

<Page current="week" width="reading" title={`Uke ${week.number}`} lead={`${rangeText(week)}${complete ? '' : ' · så langt'}`} crumbs={[{ label: 'Medier', href: base }, { label: `Uke ${week.number}`, href: `${base}uke/${week.id}/` }]}>
  <PeriodChips current="week" weekHref={`${base}uke/`} monthHref={`${base}maned/`} />
  {columns.length > 1 && <PlaysChart client:visible title={`Siste ${TREND_LENGTH} uker`} description={`Avspillinger per uke, til og med uke ${week.number}.`} ariaLabel="Avspillinger per uke" columns={columns} />}
  <PeriodView data={data} pictures={pictures} links={links} base={base} previous="uken før" />
  <OtherPeriods id="uker" title="Andre uker" name="Uke" rows={weeks} current={week.id} />
</Page>
