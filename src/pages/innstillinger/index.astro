---
// «Innstillinger»: a subpage for each kind of choice (the same as the first-run wizard's), each with what is chosen there now, «Vis introen igjen», and at the foot where the data comes from (`Credits`).
import { Button } from '@lmfaole/designsystem/components/button'
import { SettingsSection } from '@lmfaole/designsystem/components/settings-section'
import { SubPages } from '@lmfaole/designsystem/components/sub-pages'
import { orderSections, parsePrefs, PREFS_COOKIE } from '@lmfaole/designsystem/lib/preferences'
import { Credits } from '../../components/credits'
import Page from '../../layouts/Page.astro'
import { usersOf } from '../../lib/runtime'
import { frontSections, OLD_ANCHORS, SETTINGS_PAGES, settingsSummary, type SettingsPage } from '../../lib/settings-form'
import { safeBack } from '../../lib/users'

const base = import.meta.env.BASE_URL
const prefs = parsePrefs(Astro.cookies.get(PREFS_COOKIE)?.value)
const summary = settingsSummary(prefs, frontSections(prefs, orderSections), usersOf(Astro.cookies))
// The page the visitor came from goes on to the subpage, which offers the way back once saved.
const tilbake = Astro.url.searchParams.get('tilbake')
const query = tilbake === null ? '' : `?${new URLSearchParams({ tilbake: safeBack(tilbake, base) }).toString()}`
const pages = (Object.keys(SETTINGS_PAGES) as SettingsPage[]).map((page) => ({
  href: `${base}innstillinger/${page}/${query}`,
  label: SETTINGS_PAGES[page].label,
  icon: SETTINGS_PAGES[page].icon,
  ...(page === 'app' ? { description: 'Installer Medier som en app.' } : { value: summary[page] }),
}))
const anchors = Object.fromEntries(Object.entries(OLD_ANCHORS).map(([anchor, page]) => [anchor, `${base}innstillinger/${page}/`]))
---

<Page firstRun={false} current="settings" title="Innstillinger" lead="Hvem siden henter data for, hva forsiden viser, og hvordan den ser ut. Valgene lagres i informasjonskapsler i denne nettleseren.">
  <SubPages label="Innstillinger" pages={pages} />
  <SettingsSection id="introen" title="Introen" body="Introen du fikk første gang, med de samme valgene ett og ett. Den åpner seg på forsiden.">
    <form method="post" action={`${base}api/innstillinger/`}>
      <input type="hidden" name="back" value={base} />
      <Button type="submit" name="rerun" value="1" variant="outline">Vis introen igjen</Button>
    </form>
  </SettingsSection>
  <SettingsSection id="kilder" title="Kilder" body="Hvor dataene kommer fra. Ingenting lagres; hver side spør kildene når den åpnes, og svarene holdes en kort stund.">
    <Credits />
  </SettingsSection>
  <script is:inline define:vars={{ anchors }}>
    // The one long page of before had its parts at anchors (`#tema`), which a server never sees: they go to the subpage that has that part now.
    const to = anchors[location.hash.slice(1)]
    if (to !== undefined) location.replace(to + location.search)
  </script>
</Page>
