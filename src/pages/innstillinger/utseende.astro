---
// The look: the theme, the effects and the light, each chosen by its example (the effects and the light are live, so they are islands), and after them vibration, which is kept in this browser and applies at once (`HapticsSetting`: it sends nothing with the form).
import { HapticsSetting } from '@lmfaole/designsystem/components/haptics-setting'
import { parsePrefs, PREFS_COOKIE } from '@lmfaole/designsystem/lib/preferences'
import SettingsPage from '../../components/SettingsPage.astro'
import { EffectsChoice, TiltChoice } from '../../components/effect-choices'
import { SettingsForm, ThemeField } from '../../components/settings-fields'
import { settingsPageBack } from '../../lib/settings-form'
import { safeBack } from '../../lib/users'

const base = import.meta.env.BASE_URL
const tilbake = Astro.url.searchParams.get('tilbake')
const prefs = parsePrefs(Astro.cookies.get(PREFS_COOKIE)?.value)
const back = settingsPageBack(base, 'utseende', tilbake === null ? null : safeBack(tilbake, base))
---

<SettingsPage page="utseende">
  <SettingsForm action={`${base}api/innstillinger/`} back={back}>
    <ThemeField prefs={prefs} />
    <EffectsChoice client:visible value={prefs.effects} />
    <TiltChoice client:visible value={prefs.tilt} />
    <HapticsSetting client:visible />
  </SettingsForm>
</SettingsPage>
