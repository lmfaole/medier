---
import Period from '../../components/Period.astro'
import { Head } from '../../components/head'
import { OtherPeriods, PeriodChips } from '../../components/wrapped'
import { sourcesOf } from '../../lib/image-sources'
import Page from '../../layouts/Page.astro'
import { monthAt, monthRange, monthShort, monthText, monthTitle, parseMonth, recentMonths } from '../../lib/months'
import { albumPages, artistPages, titlePages, trackPages } from '../../lib/pages'
import { month as loadMonth, music, watched } from '../../lib/runtime'
import { PlaysChart } from '../../components/trend'
import TrendSection from '../../components/TrendSection.astro'
import { dayColumns, monthsUpTo, TREND_LENGTH } from '../../lib/trend'

const base = import.meta.env.BASE_URL
const now = Date.now()
const month = parseMonth(Astro.params.month ?? '')
// A month that has not begun has nothing to tell, and an address that is no month is no page.
if (month === null || month.start * 1000 > now) return Astro.rewrite('/404/')
const [data, listening, seen] = await Promise.all([loadMonth(month), music(), watched()])
if (data === null) return Astro.rewrite('/404/')
// What has a page of its own to link to: among the recent plays (artists, albums, songs) and the films and shows seen.
const links = {
  artists: new Set(listening === null ? [] : artistPages(listening).map((page) => page.name)),
  albums: new Set(listening === null ? [] : albumPages(listening).map((page) => page.slug)),
  tracks: new Set(listening === null ? [] : trackPages(listening).map((page) => page.slug)),
  titles: new Map(seen === null ? [] : titlePages(seen.items).map((page) => [page.title, page.slug] as const)),
}
const current = monthAt(now).id
const months = recentMonths(now, 12).map((one) => ({ key: one.id, label: `${monthTitle(one)}${one.id === current ? ' (så langt)' : ''}`, range: monthRange(one), href: `${base}maned/${one.id}/` }))
const complete = now >= month.end * 1000
const topAlbum = data.music?.stats.topAlbums[0]
const span = monthsUpTo(month, TREND_LENGTH).map((one) => ({ id: one.id, start: one.start, end: one.end, label: monthShort(one) }))
const days = dayColumns(data.music?.stats.byDate ?? {}, month.first, month.days)
---

<Page bare current="week" width="reading" title={monthTitle(month)} lead={`${monthRange(month)}${complete ? '' : ' · så langt'}`} crumbs={[{ label: 'Medier', href: base }, { label: monthTitle(month), href: `${base}maned/${month.id}/` }]}>
  <Head client:idle kind="Wrapped" title={monthTitle(month)} sources={sourcesOf(topAlbum?.image ?? null)} shape="album" lines={[`${monthRange(month)}${complete ? '' : ' · så langt'}`, ...(topAlbum === undefined ? [] : [`Mest spilt: ${topAlbum.title}, ${topAlbum.artist}`])]} />
  <PeriodChips current="month" weekHref={`${base}uke/`} monthHref={`${base}maned/`} />
  <TrendSection server:defer periods={span} title={`Siste ${TREND_LENGTH} måneder`} description={`Avspillinger per måned, til og med ${monthText(month)}.`} ariaLabel="Avspillinger per måned" />
  {days.some((one) => one.value > 0) && <PlaysChart client:visible title="Dag for dag" description={`Avspillinger per dag i ${monthText(month)}.`} ariaLabel="Avspillinger per dag" columns={days} labelEvery={5} />}
  <Period data={data} links={links} base={base} previous="måneden før" />
  <OtherPeriods id="maneder" title="Andre måneder" name="Måned" rows={months} current={month.id} />
</Page>
