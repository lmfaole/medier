// The old page for the usernames: they are on «Innstillinger» now, with the rest of the visitor's settings.
const tilbake = Astro.url.searchParams.get('tilbake')
return Astro.redirect(`${import.meta.env.BASE_URL}innstillinger/${tilbake === null ? '' : `?${new URLSearchParams({ tilbake }).toString()}`}`, 301)
