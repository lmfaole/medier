---
import Intro from '../../components/Intro.astro'
import { INTROS } from '../../lib/onboarding'
import { PageSection } from '@lmfaole/designsystem/components/page-section'
import { SubPages } from '@lmfaole/designsystem/components/sub-pages'
import { mediumHref } from '../../lib/media'

import { Fetched, WatchRows } from '../../components/sections'
import UsernameGate from '../../components/UsernameGate.astro'
import Page from '../../layouts/Page.astro'
import { usersOf, watched } from '../../lib/runtime'

const base = import.meta.env.BASE_URL
const users = usersOf(Astro.cookies)
const seen = users.trakt === null ? null : await watched(users)
const films = (seen?.items ?? []).filter((watch) => watch.kind === 'film')
---

<Page current="film" title="Film" lead="Filmene du har sett sist, fra Trakt.">
  {
    users.trakt === null ? (
      <UsernameGate services={['trakt']} />
    ) : (
      <>
        <Intro intro={INTROS.film} />
        <PageSection id="sett" title="Sist sett" icon="film">
          <WatchRows items={films} base={base} kind="film" />
          <SubPages
            label="Mer om filmene du har sett"
            pages={[
              { href: mediumHref(base, 'film', 'historikk/'), label: 'Historikk', icon: 'history', description: 'Alle filmene du har sett, dag for dag, og hvor lenge du så.' },
              { href: mediumHref(base, 'film', 'uke/'), label: 'Wrapped', icon: 'calendar', description: 'Oppsummeringen av hver uke og måned: filmer, sjangere, regissører og tall.' },
            ]}
          />
        </PageSection>
        <Fetched sources={[{ at: seen?.at ?? null, source: 'Trakt' }]} />
      </>
    )
  }
</Page>
