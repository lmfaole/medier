---
import Intro from '../../components/Intro.astro'
import { INTROS } from '../../lib/onboarding'
import { PageSection } from '@lmfaole/designsystem/components/page-section'
import { SubPages } from '@lmfaole/designsystem/components/sub-pages'
import { mediumHref } from '../../lib/media'

import { Fetched, ShowRows, WatchRows } from '../../components/sections'
import UsernameGate from '../../components/UsernameGate.astro'
import Page from '../../layouts/Page.astro'
import { usersOf, watched } from '../../lib/runtime'

const base = import.meta.env.BASE_URL
const users = usersOf(Astro.cookies)
const seen = users.trakt === null ? null : await watched(users)
const episodes = (seen?.items ?? []).filter((watch) => watch.kind === 'episode')
---

<Page current="tv" title="TV" lead="Episodene og seriene du har sett sist, fra Trakt.">
  {
    users.trakt === null ? (
      <UsernameGate services={['trakt']} />
    ) : (
      <>
        <SubPages
          label="Mer om TV"
          pages={[
            { href: mediumHref(base, 'tv', 'historikk/'), label: 'Historikk', icon: 'history', description: 'Alle episodene du har sett, dag for dag, og hvor lenge du så.' },
            { href: mediumHref(base, 'tv', 'uke/'), label: 'Wrapped', icon: 'calendar', description: 'Oppsummeringen av hver uke og måned: episoder, serier, maraton og tall.' },
          ]}
        />
        <Intro intro={INTROS.tv} />
        <PageSection id="sett" title="Siste episoder" icon="tv">
          <WatchRows items={episodes} base={base} kind="episode" />
        </PageSection>
        {episodes.length > 0 && (
          <PageSection id="serier" title="Serier" icon="tv">
            <ShowRows items={episodes} base={base} />
          </PageSection>
        )}
        <Fetched sources={[{ at: seen?.at ?? null, source: 'Trakt' }]} />
      </>
    )
  }
</Page>
