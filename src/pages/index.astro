---
import { PageSection } from '@lmfaole/designsystem/components/page-section'

import { Fetched, PlayRows, TopArtistRows, WatchRows } from '../components/sections'
import Page from '../layouts/Page.astro'
import { playingNow } from '../lib/now'
import { artistPictures, music, spotifyNow, watched } from '../lib/runtime'

const base = import.meta.env.BASE_URL
// The music, and the pictures of the artists in its list: the pictures need the list, so they follow it while the other sources are asked.
const withPictures = music().then(async (found) => ({ listening: found, pictures: await artistPictures((found?.topArtists ?? []).slice(0, 5).map((artist) => artist.name)) }))
const [{ listening, pictures }, seen, spotify] = await Promise.all([withPictures, watched(), spotifyNow()])
// Spotify knows what plays this second; Last.fm's scrobble is the same song a moment later, and the fallback where Spotify is not set up.
const now = playingNow(spotify, listening?.now ?? null)
---

<Page title="Medier" lead="Hva jeg hører på og ser, hentet fra Last.fm, Spotify og Trakt.">
  <PageSection id="musikk" title="Musikk" icon="music" more={{ href: `${base}musikk/`, label: 'Se all musikk' }}>
    <PlayRows plays={listening?.recent ?? []} now={now} base={base} limit={5} />
  </PageSection>
  <PageSection id="film-og-tv" title="Film og TV" icon="film" more={{ href: `${base}film-og-tv/`, label: 'Se all film og TV' }}>
    <WatchRows items={seen?.items ?? []} base={base} limit={5} />
  </PageSection>
  <PageSection id="artister" title="Mest spilt siste måned" icon="trend-up">
    <TopArtistRows artists={(listening?.topArtists ?? []).slice(0, 5)} base={base} pictures={pictures} />
  </PageSection>
  <Fetched sources={[{ at: listening?.at ?? null, source: 'Last.fm' }, { at: seen?.at ?? null, source: 'Trakt' }]} />
</Page>
