---
import { MarkSeen } from '@lmfaole/designsystem/components/mark-seen'
import Intro from '../../components/Intro.astro'
import { INTROS, NEW_HISTORIKK, SEEN_PATH } from '../../lib/onboarding'
import { PageSection } from '@lmfaole/designsystem/components/page-section'

import { HistoryTimeline, Sessions } from '../../components/history'
import { Fetched } from '../../components/sections'
import UsernameGate from '../../components/UsernameGate.astro'
import Page from '../../layouts/Page.astro'
import { playingNow } from '../../lib/now'
import { music, usersOf, watched } from '../../lib/runtime'
import type { Service } from '../../lib/users'

const base = import.meta.env.BASE_URL
const users = usersOf(Astro.cookies)
const [listening, seen] = await Promise.all([music(users), watched(users)])
const playing = playingNow(listening?.now ?? null)
const plays = listening?.recent ?? []
const watches = seen?.items ?? []
const now = new Date().toISOString()
// The history is of what has a username; a form asks for the other (or both, and then there is nothing else).
const missing: Service[] = [...(users.lastfm === null ? (['lastfm'] as const) : []), ...(users.trakt === null ? (['trakt'] as const) : [])]
const sources = [...(users.lastfm === null ? [] : [{ at: listening?.at ?? null, source: 'Last.fm' }]), ...(users.trakt === null ? [] : [{ at: seen?.at ?? null, source: 'Trakt' }])]
---

<Page current="history" title="Historikk" lead="Det du har hørt på og sett, dag for dag, og hvor lenge det varte, fra Last.fm og Trakt." crumbs={[{ label: 'Medier', href: base }, { label: 'Historikk', href: `${base}historikk/` }]}>
  {missing.length === 2 && <UsernameGate services={missing} />}
  {
    missing.length < 2 && (
      <>
        <Intro intro={INTROS.historikk} />
        <PageSection id="okter" title="Lytte- og titteøkter" icon="listen">
          <Sessions plays={plays} watches={watches} now={now} playing={playing} />
        </PageSection>
        <PageSection id="tidslinje" title="Tidslinje" icon="history">
          <HistoryTimeline plays={plays} watches={watches} now={now} playing={playing} base={base} />
        </PageSection>
        {missing.length === 1 && <UsernameGate services={missing} title={missing[0] === 'lastfm' ? 'Vil du ha med musikken?' : 'Vil du ha med film og TV?'} />}
        <Fetched sources={sources} />
      </>
    )
  }
  <MarkSeen client:idle id={NEW_HISTORIKK.id} cookiePath={SEEN_PATH} />
</Page>
