---
import '../styles.css'
import { Breadcrumbs, type Crumb } from '@lmfaole/designsystem/components/breadcrumbs'
import { PageHeader } from '@lmfaole/designsystem/components/page-header'
import { Stack } from '@lmfaole/designsystem/components/layout'
import { ConnectionBanner } from '@lmfaole/designsystem/components/connection-banner'

import { Credits } from '../components/credits'
import { Frame, type Place } from '../components/frame'
import { UserChip } from '@lmfaole/designsystem/components/user-chip'
import { isSeen, parseSeen, SEEN_COOKIE } from '@lmfaole/designsystem/lib/onboarding'
import { TextLink } from '@lmfaole/designsystem/components/text'
import { htmlAttributes, parsePrefs, PREFS_COOKIE } from '@lmfaole/designsystem/lib/preferences'
import FirstRunWizard from '../components/FirstRunWizard.astro'
import { NEW_HISTORIKK } from '../lib/onboarding'
import { usersOf } from '../lib/runtime'
import { usersText } from '../lib/users'

interface Props {
  title: string
  lead: string
  /** The pages above this one; none on the front page. */
  crumbs?: Crumb[]
  /** `pane` for a detail page: the reading column and a `Split` pane beside it on a wide screen. */
  width?: 'reading' | 'pane'
  /** The place of the app this page is in (for a detail page, the list it belongs to); none for a page that is in none (the offline page). */
  current?: Place
  /** A page whose own head (`DetailHeader`) is its `<h1>`: the title and the lead are in the document's head and its description, and not drawn here. */
  bare?: boolean
  /** The first-run wizard on a first visit; not on «Innstillinger» (which has the same fields) or a page made ahead of time (the offline page), which has no cookies to read. */
  firstRun?: boolean
}
const { title, lead, crumbs, width = 'reading', current, bare = false, firstRun = true } = Astro.props
// The visitor's theme, effects and tilt on <html> from the first frame (`prefs` cookie; the design system reads the attributes).
const attributes = htmlAttributes(parsePrefs(Astro.cookies.get(PREFS_COOKIE)?.value))
const base = import.meta.env.BASE_URL
// Whose data the pages show, at the foot of every page once given, with the way to change it.
const who = usersText(usersOf(Astro.cookies))
// «Nytt» on Historikk in the navigation, for a while and until it has been opened (its page marks it seen).
const fresh = { place: 'history' as const, until: NEW_HISTORIKK.until, now: new Date().toISOString(), seen: isSeen(parseSeen(Astro.cookies.get(SEEN_COOKIE)?.value), NEW_HISTORIKK.id) }
const change = `${base}innstillinger/?tilbake=${encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`)}`
---

<!doctype html>
<html lang="nb" {...attributes}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{crumbs === undefined ? title : `${title} – Medier`}</title>
    <meta name="description" content={lead} />
    <!-- The installed app: the manifest, the colour of the bar in each scheme (the design system's background, light and dark), the icons, and Safari's own way of saying «installed». -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Medier" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  </head>
  <body>
    <Frame base={base} current={current} width={width} fresh={fresh}>
      <Stack gap="xl">
        <ConnectionBanner client:idle />
        {crumbs === undefined ? null : <Breadcrumbs items={crumbs} />}
        {bare ? null : <PageHeader title={title} lead={lead} />}
        <slot />
        {who !== null && <UserChip user={who} href={change} />}
        <TextLink href={change}>Innstillinger</TextLink>
        <Credits />
      </Stack>
    </Frame>
    {firstRun && <FirstRunWizard />}
    <script is:inline>
      // The service worker makes the app open without a network (`public/sw.js`); a browser without one, or one that refuses it, simply has the site as before.
      if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {}))
    </script>
  </body>
</html>
