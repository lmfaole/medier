---
import '../styles.css'
import { Breadcrumbs, type Crumb } from '@lmfaole/designsystem/components/breadcrumbs'
import { PageHeader } from '@lmfaole/designsystem/components/page-header'
import { PageLayout } from '@lmfaole/designsystem/components/page-layout'
import { Stack } from '@lmfaole/designsystem/components/layout'

interface Props {
  title: string
  lead: string
  /** The pages above this one; none on the front page. */
  crumbs?: Crumb[]
}
const { title, lead, crumbs } = Astro.props
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{crumbs === undefined ? title : `${title} – Medier`}</title>
    <meta name="description" content={lead} />
  </head>
  <body>
    <PageLayout>
      <Stack gap="xl">
        {crumbs === undefined ? null : <Breadcrumbs items={crumbs} />}
        <PageHeader title={title} lead={lead} />
        <slot />
      </Stack>
    </PageLayout>
  </body>
</html>
