# https://editorconfig.org
#
# One place that decides whitespace for every contributor and every tool, so
# the diff contains the change and not the formatting. Agents format files too,
# so this file is also what keeps an agent from producing a diff full of
# unrelated whitespace changes.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Two trailing spaces are a line break in Markdown, so stripping them would
# silently change the rendered document.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{py,go,rs}]
indent_size = 4